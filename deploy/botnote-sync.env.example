# Installed privately as /etc/botnote/botnote-sync.env (root:root, mode 0600).
# HPKE private and public keys are systemd credentials, never environment values.
BOTNOTE_ENVIRONMENT=production
BOTNOTE_DATABASE_URL=postgresql+psycopg:///botnote
BOTNOTE_TOKEN_PEPPER=replace-with-current-token-pepper
BOTNOTE_TOKEN_PREVIOUS_PEPPERS=[]
BOTNOTE_AUTONOMOUS_SYNC_ENABLED=false
BOTNOTE_AUTONOMOUS_SYNC_ENROLLMENT_ENABLED=false
BOTNOTE_AUTONOMOUS_SYNC_ROLLOUT=off
# Canary IDs and the optional owner login are sync-only systemd credentials.
# A private systemd drop-in may map the existing owner-imt-password credential path.
