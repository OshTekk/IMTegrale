#!/usr/bin/env python3
from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from sync_hpke_keysets import (  # noqa: E402,F401
    DEFAULT_DIRECTORY,
    EXPECTED_FILES,
    KEYSET_FILE,
    KEYSET_VERSION,
    LEGACY_KEYSET_VERSION,
    PURPOSES,
    ProvisionError,
    activate_generation,
    prepare_rotation,
    provision,
    retire_generation,
    verify,
)


def main() -> None:
    parser = argparse.ArgumentParser(description="Provision isolated sync HPKE keys")
    parser.add_argument(
        "action",
        choices=(
            "provision",
            "verify",
            "prepare-rotation",
            "activate-generation",
            "retire-generation",
        ),
    )
    parser.add_argument("--directory", type=Path, default=DEFAULT_DIRECTORY)
    parser.add_argument("--purpose", choices=PURPOSES)
    parser.add_argument("--generation", type=int)
    parser.add_argument("--referenced-envelopes", type=int, default=0)
    parser.add_argument("--delete-private", action="store_true")
    parser.add_argument("--confirm")
    args = parser.parse_args()

    try:
        if args.action == "provision":
            provision(args.directory)
        elif args.action == "verify":
            verify(args.directory)
        elif args.action == "prepare-rotation":
            if args.purpose is None:
                raise ProvisionError("SYNC_HPKE_PURPOSE_REQUIRED")
            prepare_rotation(
                args.directory,
                purpose=args.purpose,
                generation=args.generation,
            )
        elif args.action == "activate-generation":
            if args.purpose is None or args.generation is None:
                raise ProvisionError("SYNC_HPKE_GENERATION_REQUIRED")
            activate_generation(
                args.directory,
                purpose=args.purpose,
                generation=args.generation,
                confirmed=args.confirm == "ACTIVATE-HPKE-GENERATION",
            )
        else:
            if args.purpose is None or args.generation is None:
                raise ProvisionError("SYNC_HPKE_GENERATION_REQUIRED")
            retire_generation(
                args.directory,
                purpose=args.purpose,
                generation=args.generation,
                referenced_envelopes=args.referenced_envelopes,
                delete_private=args.delete_private,
                confirmed=args.confirm == "RETIRE-HPKE-GENERATION",
            )
    except ProvisionError as exc:
        raise SystemExit(f"sync-hpke: denied code={exc.code}") from None
    print("sync-hpke: ok")


if __name__ == "__main__":
    main()
