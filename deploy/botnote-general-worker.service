[Unit]
Description=IMTégrale general worker (calendar, outbox, scheduler)
After=network-online.target postgresql.service systemd-tmpfiles-setup.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=exec
User=botnote
Group=botnote
WorkingDirectory=/opt/botnote/current
EnvironmentFile=/etc/botnote/botnote-runtime.env
EnvironmentFile=/etc/botnote/botnote.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=RUNTIME_IDENTIFIER_CREDENTIALS_DIRECTORY=/run/credentials/botnote-general-worker.service
LoadCredential=autonomous-sync-canary-account-ids
ExecStart=/opt/botnote/runtime/bin/botnote worker general
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
MemoryMax=512M
TasksMax=32
KillMode=control-group
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
InaccessiblePaths=-/etc/botnote/sync-hpke
InaccessiblePaths=-/etc/credstore
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
