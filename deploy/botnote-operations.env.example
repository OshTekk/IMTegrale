# Root-owned, non-identifying environment for botnote-operations-check.service.
BOTNOTE_ENVIRONMENT=production
BOTNOTE_DATABASE_URL=postgresql+psycopg:///botnote
BOTNOTE_WORKER_HEARTBEAT_TTL_SECONDS=180
BOTNOTE_AUTONOMOUS_SYNC_ENABLED=false
BOTNOTE_AUTONOMOUS_SYNC_ENROLLMENT_ENABLED=false
BOTNOTE_AUTONOMOUS_SYNC_ROLLOUT=off
